set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY DDS
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:24:59  MAY 13, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation

# --- Arquivos fonte ---
set_global_assignment -name VHDL_FILE DDS.vhd
set_global_assignment -name VHDL_FILE DDS_core.vhd
set_global_assignment -name VHDL_FILE DDS_sine_rom.vhd

# =============================================================================
# Pinagem - Altera DE2-115 (EP4CE115F29C7)
# Referencia: DE2-115 User Manual, Table 4-1 / 4-6 / 4-32
# =============================================================================

# --- Clock de sistema ---
set_location_assignment PIN_Y2   -to clk

# --- Reset (KEY[0], ativo em nivel baixo) ---
set_location_assignment PIN_M23  -to rst_n

# --- Selecao de frequencia via SW[4:0] ---
set_location_assignment PIN_AB28 -to sw[0]
set_location_assignment PIN_AC28 -to sw[1]
set_location_assignment PIN_AC27 -to sw[2]
set_location_assignment PIN_AD27 -to sw[3]
set_location_assignment PIN_AB27 -to sw[4]

# --- GPIO_0 (conector JP1) ---
# Pino fisico JP1 | GPIO_0[n] | Sinal VHDL
#        1        |    [0]    | gnd_out  (referencia GND logico)
#        3        |    [1]    | clk_out  (clock 10 MHz p/ DAC)
#        5        |    [2]    | dac_out[0]  LSB
#        7        |    [3]    | dac_out[1]
#        9        |    [4]    | dac_out[2]
#       11        |    [5]    | dac_out[3]
#       13        |    [6]    | dac_out[4]
#       15        |    [7]    | dac_out[5]
#       17        |    [8]    | dac_out[6]
#       19        |    [9]    | dac_out[7]  MSB
set_location_assignment PIN_AB22 -to gnd_out
set_location_assignment PIN_AC15 -to clk_out
set_location_assignment PIN_AB21 -to dac_out[0]
set_location_assignment PIN_Y17  -to dac_out[1]
set_location_assignment PIN_AC21 -to dac_out[2]
set_location_assignment PIN_Y16  -to dac_out[3]
set_location_assignment PIN_AD21 -to dac_out[4]
set_location_assignment PIN_AE16 -to dac_out[5]
set_location_assignment PIN_AD15 -to dac_out[6]
set_location_assignment PIN_AE15 -to dac_out[7]

# --- Padroes de tensao (3.3-V LVTTL) ---
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sw[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gnd_out
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_out
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dac_out[7]

# --- Particoes (gerenciado pelo Quartus) ---
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top